#!/bin/sh
# 方針 (policy.json) の規則 (拒否を除く) の宛先から、dnsmasq が上流に問い合わせる名前の一覧を作り直す。
#
#   chloe-dns-update <状態のディレクトリ> <policy.json> [--no-reload]
#
# "*.example.com" は dnsmasq では example.com とそのサブドメインに一致する (少し広い)。
# --no-reload がなければ、dnsmasq に SIGHUP を送って一覧を読み直させる。
set -eu
run="$1/run"
policy="$2"
upstream="$(cat "$run/upstream-dns")"
tmp="$run/dnsmasq-servers.conf.tmp"
: > "$tmp"
for name in $(jq -r '[.rules[] | select(.action != "deny") | .hosts[]] | unique | .[] | ltrimstr("*.")' "$policy"); do
    echo "server=/$name/$upstream" >> "$tmp"
done
mv "$tmp" "$run/dnsmasq-servers.conf"
if [ "${3:-}" != --no-reload ]; then
    kill -HUP "$(cat "$run/dnsmasq.pid")"
fi

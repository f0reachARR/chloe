[Unit]
Description=Mount chloe workspace image
DefaultDependencies=no
After=local-fs.target
Before=docker.service systemd-user-sessions.service
ConditionPathExists=/dev/vdb

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/chloe-mount-workspace

[Install]
WantedBy=multi-user.target

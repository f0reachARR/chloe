#!/bin/sh
# ワークスペースのイメージ (/dev/vdb) を初期化してマウントする。
# イメージの中は home/ と workspace/ に分け、それぞれ /home/user と /workspace に bind する。
set -eu

dev=/dev/vdb
mnt=/var/lib/chloe/workspace

mount "$dev" "$mnt"

if [ ! -d "$mnt/home" ]; then
    mkdir -p "$mnt/home" "$mnt/workspace"
    cp -a /etc/skel/. "$mnt/home/"
    chown -R user:user "$mnt/home" "$mnt/workspace"
fi

mount --bind "$mnt/home" /home/user
mount --bind "$mnt/workspace" /workspace

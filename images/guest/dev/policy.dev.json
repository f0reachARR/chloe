{
  "inject": [
    {
      "name": "test",
      "placeholder": "chloe-ph-test-4f1d2c9a7b",
      "hosts": [
        "httpbin.org"
      ],
      "header": "authorization",
      "format": "replace",
      "secret_env": "CHLOE_SECRET_TEST"
    },
    {
      "name": "anthropic",
      "placeholder": "sk-ant-api03-chloe-ph-8e2a6f0c31d94b7a",
      "hosts": [
        "api.anthropic.com"
      ],
      "header": "x-api-key",
      "format": "replace",
      "secret_env": "CHLOE_SECRET_ANTHROPIC"
    },
    {
      "name": "openai",
      "placeholder": "sk-proj-chloe-ph-5b7d3e1f9a2c4068",
      "hosts": [
        "api.openai.com"
      ],
      "header": "authorization",
      "format": "replace",
      "secret_env": "CHLOE_SECRET_OPENAI"
    }
  ],
  "rules": [
    {
      "name": "no-delete",
      "hosts": [
        "httpbin.org"
      ],
      "methods": [
        "DELETE"
      ],
      "paths": [
        "/anything/**"
      ],
      "action": "deny"
    },
    {
      "hosts": [
        "httpbin.org"
      ],
      "paths": [
        "/anything/allowed/**"
      ],
      "action": "allow"
    },
    {
      "name": "anything-default",
      "hosts": [
        "httpbin.org"
      ],
      "paths": [
        "/anything/**"
      ],
      "action": "deny"
    },
    {
      "name": "default",
      "hosts": [
        "api.anthropic.com",
        "statsig.anthropic.com",
        "sentry.io",
        "*.sentry.io",
        "api.openai.com",
        "auth.openai.com",
        "chatgpt.com",
        "*.chatgpt.com",
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "mise-versions.jdx.dev",
        "httpbin.org",
        "example.org"
      ],
      "action": "allow"
    },
    {
      "name": "passthrough",
      "hosts": [
        "registry-1.docker.io",
        "auth.docker.io",
        "*.docker.com",
        "*.ubuntu.com"
      ],
      "action": "passthrough"
    }
  ]
}

# systemd で動かすランナーの設定の例 (/etc/chloe/runner.env)。配置は docs/install.md の「配置」に合わせてある。
# ランナーの unit (root で動く部分を含む) が読むので、root だけが書けるようにする。
#
#   sudo install -m 644 deploy/runner.env /etc/chloe/runner.env
#
# ゲートウェイか chloe-node の設定の [runner] に kind = "systemd" と書くと、このファイルを読む。

# ワークスペースごとの状態 (ディスク、CA、ログ)。chloe の利用者が書けるディレクトリにする。
# chloe-node のホストでは /var/lib/chloe-node/workspaces にする。
CHLOE_STATE_ROOT=/var/lib/chloe/workspaces
# カーネルと rootfs を置いたディレクトリ。
CHLOE_GUEST_DIR=/usr/local/lib/chloe/guest
CHLOE_EGRESS_BIN=/usr/local/lib/chloe/chloe-egress
# ランナーの namespace とホストをつなぐ veth のアドレス。ランナー一つに /30 を使う。
# ホストのネットワークと重ならない範囲にする。
CHLOE_NET_POOL=10.250.0.0/16

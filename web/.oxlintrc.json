{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "vitest"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "src/shared/api/schema.d.ts"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "no-console": "warn",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/*",
                  "@/routes",
                  "@/routes/*",
                  "@/features",
                  "@/features/*"
                ],
                "message": "shared は機能、枠、ルートを使わない (docs/web.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*", "@/routes", "@/routes/*"],
                "message": "機能は枠とルートを使わない (docs/web.md)"
              },
              {
                "group": ["@/features", "@/features/*", "../../*"],
                "message": "機能どうしは互いを使わない。要るものは shared に上げる (自分の機能の中は相対パスで書く) (docs/web.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**", "src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/*", "../features/*/*"],
                "message": "機能は入口 (@/features/<機能>) から使う (docs/web.md)"
              }
            ]
          }
        ]
      }
    }
  ]
}

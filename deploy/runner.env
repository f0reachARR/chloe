# Example configuration for systemd runners (/etc/chloe/runner.env). Paths match the layout in docs/install.md.
# Read by the runner unit (including parts running as root), so make it writable only by root.
#
#   sudo install -m 644 deploy/runner.env /etc/chloe/runner.env
#
# This file is read when [runner] in the gateway or chloe-node configuration has kind = "systemd".

# Per-workspace state (disks, CA, logs). Must be writable by the chloe user.
# Same location on gateway and chloe-node hosts (created by deploy/tmpfiles/chloe.conf).
CHLOE_STATE_ROOT=/var/lib/chloe/workspaces
# Directory with the kernel and rootfs.
CHLOE_GUEST_DIR=/usr/local/lib/chloe/guest
CHLOE_EGRESS_BIN=/usr/local/lib/chloe/chloe-egress
# Addresses for veth pairs connecting runner namespaces to the host. Each runner uses a /30.
# Choose a range that does not overlap the host's networks.
CHLOE_NET_POOL=10.250.0.0/16
